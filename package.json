{
  "name": "openvocaly",
  "productName": "OpenVocaly",
  "version": "1.0.0",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "license": "AGPL-3.0-only",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "routes:generate": "tsr generate",
    "routes:watch": "tsr watch",
    "prepare:local-runtime": "npm run build:macos-asr-host && npm run build:whisper-cpp-runtime",
    "prepare:macos-fast-paste": "node scripts/build-macos-fast-paste.js",
    "setup:dev": "node scripts/setup-local-dev.js && npm run db:migrate",
    "predev": "npm run routes:generate && npm run prepare:local-runtime && npm run prepare:macos-fast-paste && npm run deps:electron",
    "prebuild": "npm run prepare:local-runtime",
    "pretypecheck": "npm run routes:generate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio --config drizzle.app.config.ts",
    "deps:electron": "electron-builder install-app-deps",
    "build:macos-asr-host": "node scripts/build-macos-asr-host.js",
    "build:whisper-cpp-runtime": "node scripts/build-whisper-cpp-runtime.js",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "npm run deps:electron",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "npm run prepare:macos-fast-paste && npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.2.0",
    "@date-fns/tz": "^1.4.1",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@libsql/client": "^0.17.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.161.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "ffmpeg-static": "^5.3.0",
    "libsql": "^0.5.22",
    "lucide-react": "0.564.0",
    "mitt": "^3.0.1",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "react-day-picker": "^9.14.0",
    "react-error-boundary": "^6.1.1",
    "recharts": "^2.15.4",
    "shadcn": "^4.0.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "3.4.1",
    "tw-animate-css": "1.4.0",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "@openvocaly/ptt-hook-macos": "file:./native/ptt-hook-macos"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tailwindcss/vite": "4.1.18",
    "@tanstack/router-cli": "^1.161.1",
    "@tanstack/router-plugin": "^1.161.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "drizzle-kit": "^0.31.9",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^4.1.11"
  }
}
