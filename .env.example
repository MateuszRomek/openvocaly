# Custom renderer dev server port for local development.
# Remove this line to fall back to Vite's default port behavior.
RENDERER_DEV_SERVER_PORT=5180

# Main-process logging level (fatal|error|warn|info|debug|trace|silent).
# Keep this at debug while validating auto-paste/manual-fallback behavior.
LOG_LEVEL=info

# Pretty-print logs in development (1=on, 0=off).
LOG_PRETTY=1